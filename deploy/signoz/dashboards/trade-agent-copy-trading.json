    "variables": [],
    "panels": {
      "leads-selected-now": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Traders acompanhados",
            "description": "Perfis lead_consensus (D-052): seguem lead traders do Copy Trading Spot da Binance (os melhores, ou os que mais operam nos perfis de teste, D-054 e D-056) e só compram o que pelo menos min_backers deles compraram e os candles do próprio par confirmam (no de alto risco, D-056, só o teto do stop). Tamanho, stop e alvo são do perfil: nenhuma operação é copiada."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/ClickHouseSQL",
                  "spec": {
                    "name": "A",
                    "query": "SELECT argMax(export, unix_milli) AS value FROM ( SELECT unix_milli, sum(value) AS export FROM signoz_metrics.distributed_samples_v4 WHERE metric_name = 'trade_agent.leads.selected' AND unix_milli >= $start_timestamp_ms AND unix_milli <= $end_timestamp_ms GROUP BY unix_milli ) HAVING count() > 0",
                    "disabled": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
