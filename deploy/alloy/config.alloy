// Collects the logs of the trade-agent project's containers and sends them to Loki.
// The Docker API is read through the read-only proxy (docker-proxy service), never the socket.
// Labels in Loki: service (the compose service) and level. In the agent, structlog's `event`
// and `trace_id` fields go as structured metadata: {service="agent"} | event="risk.snapshot".

logging {
	level  = "warn"
	format = "logfmt"
}

discovery.docker "trade_agent" {
	host             = "tcp://docker-proxy:2375"
	refresh_interval = "15s"

	// only this project's containers (the filter runs in the Docker API itself)
	filter {
		name   = "label"
		values = ["com.docker.compose.project=trade-agent"]
	}
}

// SigNoz's internals (ClickHouse, keeper, migrations...) log every query: they are left
// out (see them with `docker compose logs <service>`). The drop is in the target list: a
// "drop" in relabel_rules does not remove the container from collection, it only erases
// the labels of its logs.
discovery.relabel "collected" {
	targets = discovery.docker.trade_agent.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "ingester|signoz-.+"
		action        = "drop"
	}

	// Each container's read position is kept by the target's labels. Network, IP and port
	// change when Docker restarts: with them, Alloy did not find the position and re-read the
	// whole log. Only the labels that are stable while the container exists remain.
	rule {
		regex  = "__meta_docker_container_(id|name|label_com_docker_compose_service)"
		action = "labelkeep"
	}
}

discovery.relabel "trade_agent" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "trade_agent" {
	host          = "tcp://docker-proxy:2375"
	targets       = discovery.relabel.collected.output
	relabel_rules = discovery.relabel.trade_agent.rules
	forward_to    = [loki.process.trade_agent.receiver]
}

loki.process "trade_agent" {
	forward_to = [loki.write.loki.receiver, loki.process.signoz.receiver]

	// Agent: one structlog JSON per line. A Python traceback (text, several lines)
	// becomes a single record, starting at "Traceback".
	stage.match {
		selector = "{service=\"agent\"}"

		stage.multiline {
			firstline     = "^(\\{|Traceback)"
			max_wait_time = "3s"
			max_lines     = 1000
		}

		stage.json {
			expressions = {level = "", event = "", trace_id = ""}
		}

		stage.labels {
			values = {level = ""}
		}

		// trace_id links the log to the trace in Jaeger: {service="agent"} | trace_id="..."
		stage.structured_metadata {
			values = {event = "", trace_id = ""}
		}
	}

	// container-metrics: docker_stats tries to inspect every container that changes state and,
	// if it already vanished (the lab's docker run --rm, a recreation by compose), logs
	// "No such container" as an error: dozens per hour, harmless. They are left out.
	stage.match {
		selector            = "{service=\"container-metrics\"} |= \"Could not inspect updated container\" |= \"No such container\""
		action              = "drop"
		drop_counter_reason = "container_gone"
	}

	// Jaeger and container-metrics (OpenTelemetry Collector): JSON with "level".
	stage.match {
		selector = "{service=~\"jaeger|container-metrics\"}"

		stage.json {
			expressions = {level = ""}
		}

		stage.labels {
			values = {level = ""}
		}
	}

	stage.match {
		selector = "{service=\"agent\"} |~ \"^Traceback\""

		stage.static_labels {
			values = {level = "error"}
		}
	}

	// Grafana, Loki and Alloy log in logfmt (level=info ...).
	stage.match {
		selector = "{service=~\"grafana|loki|alloy\"}"

		stage.logfmt {
			mapping = {level = ""}
		}

		stage.labels {
			values = {level = ""}
		}
	}

	// PostgreSQL: "... [pid] LOG:  ...", "... ERROR:  ...", "... FATAL:  ...".
	stage.match {
		selector = "{service=\"postgres\"}"

		stage.static_labels {
			values = {level = "info"}
		}
	}

	stage.match {
		selector = "{service=\"postgres\"} |~ \"\\\\b(ERROR|FATAL|PANIC):\""

		stage.static_labels {
			values = {level = "error"}
		}
	}

	stage.match {
		selector = "{service=\"postgres\"} |~ \"\\\\bWARNING:\""

		stage.static_labels {
			values = {level = "warning"}
		}
	}
}

loki.write "loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// A copy of the same logs to SigNoz (OTLP), alongside Loki. Each Loki entry becomes a
// record with its own resource; the labels (service, level) and the metadata (event,
// trace_id) arrive as attributes.
//
// Alloy's own warnings about this sending (full queue, SigNoz down) stay only in Loki:
// each such line would be one more send to the full queue, which would then never drain
// (Alloy once logged millions of lines per hour when it came up before SigNoz).
loki.process "signoz" {
	forward_to = [otelcol.receiver.loki.signoz.receiver]

	stage.match {
		selector            = "{service=\"alloy\"} |= \"component_id=otelcol.\""
		action              = "drop"
		drop_counter_reason = "signoz_self"
	}
}

otelcol.receiver.loki "signoz" {
	output {
		logs = [otelcol.processor.transform.signoz.input]
	}
}

otelcol.processor.transform "signoz" {
	error_mode = "ignore"

	log_statements {
		context    = "log"
		statements = [
			`set(resource.attributes["service.name"], attributes["service"]) where attributes["service"] != nil`,
			`set(resource.attributes["service.namespace"], "trade-agent")`,
			`delete_key(attributes, "loki.attribute.labels")`,
			`set(severity_text, attributes["level"]) where attributes["level"] != nil`,
			`set(severity_number, SEVERITY_NUMBER_DEBUG) where severity_text == "debug"`,
			`set(severity_number, SEVERITY_NUMBER_INFO) where severity_text == "info"`,
			`set(severity_number, SEVERITY_NUMBER_WARN) where severity_text == "warn" or severity_text == "warning"`,
			`set(severity_number, SEVERITY_NUMBER_ERROR) where severity_text == "error"`,
			`set(severity_number, SEVERITY_NUMBER_FATAL) where severity_text == "critical" or severity_text == "fatal"`,
			// JSON (agent, Jaeger): each field becomes a searchable attribute; trace_id links to the trace
			`merge_maps(cache, ParseJSON(body), "upsert") where IsMatch(body, "^\\{")`,
			`flatten(cache)`,
			`merge_maps(attributes, cache, "insert")`,
			`set(trace_id.string, cache["trace_id"]) where cache["trace_id"] != nil`,
			`set(span_id.string, cache["span_id"]) where cache["span_id"] != nil`,
		]
	}

	output {
		logs = [otelcol.processor.batch.signoz.input]
	}
}

// In batches: without this, each log line was one send (and one place in the queue).
otelcol.processor.batch "signoz" {
	output {
		logs = [otelcol.exporter.otlphttp.signoz.input]
	}
}

otelcol.exporter.otlphttp "signoz" {
	client {
		endpoint = "http://signoz-ingester:4318"
	}
}
