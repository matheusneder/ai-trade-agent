      "options": {},
      "id": 10
    },
    {
      "type": "table",
      "title": "Mudanças de estado (risco)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 16,
        "h": 8,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT created_at AS time, payload->>'scope' AS escopo, payload->>'state' AS estado, payload->>'reason' AS motivo, payload->>'source' AS origem FROM events WHERE kind = 'risk.state_changed' AND $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 11
    },
    {
      "type": "table",
      "title": "Última execução por tarefa",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 24,
        "h": 6,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT kind AS tarefa, max(created_at) AS ultima FROM events WHERE kind IN ('agent.started', 'decision.cycle', 'risk.state_changed') GROUP BY kind ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 12
    }
  ]
}
