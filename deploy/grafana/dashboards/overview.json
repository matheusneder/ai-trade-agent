          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT at AS time, equity::float AS patrimonio, peak_equity::float AS pico FROM telemetry_snapshots WHERE $__timeFilter(at) ORDER BY 1"
