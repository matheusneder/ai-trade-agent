    {
      "type": "timeseries",
      "title": "Ganhos e perdas por escopo (USDT)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT at AS time, 'global' AS metric, (realized_pnl + unrealized_pnl)::float AS value FROM telemetry_snapshots WHERE $__timeFilter(at) UNION ALL SELECT at AS time, key AS metric, (value->>'pnl')::float AS value FROM telemetry_snapshots, jsonb_each(profiles) WHERE $__timeFilter(at) AND value->>'pnl' IS NOT NULL ORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Ganhos e perdas por escopo do dia (USDT)",
      "description": "Resultado de cada escopo só no dia corrente, em UTC (o dia do agente, do PnL do dia e do Risk Guard): os ganhos e perdas por escopo de cada foto menos os da primeira foto do dia. Zera na virada do dia UTC (21h em Brasília) e não depende do intervalo selecionado (o gráfico mostra sempre o dia até agora). Sem foto no dia (logo após a virada, com o agente parado) fica sem dados; reinícios do agente não zeram o dia.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "WITH bounds AS ( SELECT date_trunc('day', instant, 'UTC') AS day_start, instant FROM (SELECT now() AS instant) AS clock ), today AS ( SELECT at, 'global' AS escopo, realized_pnl + unrealized_pnl AS pnl FROM telemetry_snapshots, bounds WHERE at >= day_start AND at <= instant UNION ALL SELECT at, key, (value->>'pnl')::numeric FROM telemetry_snapshots, bounds, jsonb_each(profiles) WHERE at >= day_start AND at <= instant AND value->>'pnl' IS NOT NULL ) SELECT at AS time, escopo AS metric, (pnl - first_value(pnl) OVER (PARTITION BY escopo ORDER BY at))::float AS value FROM today ORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "timeFrom": "now/d",
      "id": 9
    },
    {
      "type": "table",
