        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "trade-agent-loki"
          },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({service=~\"$service\", level=~\"warning|warn|error|critical|fatal\"} [$__auto]))",
