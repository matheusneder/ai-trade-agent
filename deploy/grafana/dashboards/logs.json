      "datasource": {
        "type": "loki",
        "uid": "trade-agent-loki"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "trade-agent-loki"
          },
          "editorMode": "code",
          "expr": "sum by (level) (count_over_time({service=~\"$service\", level=~\"$level\"} |~ \"(?i)$busca\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "type": "timeseries",
