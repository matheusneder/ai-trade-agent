      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "trade-agent-loki"
          },
          "editorMode": "code",
          "expr": "topk(15, sum by (event) (count_over_time({service=\"agent\", level=~\"$level\"} | event != \"\" [$__range])))",
