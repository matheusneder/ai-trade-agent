{
  "uid": "ta-logs",
  "title": "Trade Agent — Logs",
  "tags": [
    "trade-agent"
  ],
  "timezone": "utc",
  "editable": true,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Erros (24h)",
      "datasource": {
        "type": "loki",
        "uid": "trade-agent-loki"
      },
      "gridPos": {
        "w": 8,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "trade-agent-loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=~\"$service\", level=~\"error|critical|fatal\"}[24h]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 1
    },
    {
      "type": "stat",
      "title": "Avisos (24h)",
      "datasource": {
        "type": "loki",
        "uid": "trade-agent-loki"
      },
      "gridPos": {
        "w": 8,
        "h": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "trade-agent-loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=~\"$service\", level=~\"warning|warn\"}[24h]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "type": "stat",
      "title": "Tracebacks do agente (24h)",
      "datasource": {
        "type": "loki",
        "uid": "trade-agent-loki"
      },
      "gridPos": {
        "w": 8,
        "h": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "trade-agent-loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=\"agent\"} |~ \"^Traceback\" [24h]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 3
