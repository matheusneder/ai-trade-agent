{
  "uid": "ta-performance",
  "title": "Trade Agent — Performance",
  "tags": [
    "trade-agent"
  ],
  "timezone": "utc",
  "editable": true,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "PnL realizado acumulado",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT closed_at AS time, sum(realized_pnl) OVER (ORDER BY closed_at, id)::float AS pnl_acumulado FROM positions WHERE state = 'closed' AND realized_pnl IS NOT NULL AND $__timeFilter(closed_at) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 1
    },
    {
      "type": "stat",
      "title": "Trades",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS trades FROM positions WHERE state = 'closed' AND realized_pnl IS NOT NULL AND $__timeFilter(closed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "type": "stat",
      "title": "Taxa de acerto",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 6,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(avg((realized_pnl > 0)::int) * 100, 0)::float AS acerto FROM positions WHERE state = 'closed' AND realized_pnl IS NOT NULL AND $__timeFilter(closed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "type": "stat",
      "title": "Profit factor",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT (sum(realized_pnl) FILTER (WHERE realized_pnl > 0) / nullif(-sum(realized_pnl) FILTER (WHERE realized_pnl < 0), 0))::float AS profit_factor FROM positions WHERE state = 'closed' AND realized_pnl IS NOT NULL AND $__timeFilter(closed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "type": "stat",
      "title": "Taxas pagas (USDT)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 18,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(sum((fees->>'USDT')::numeric), 0)::float AS taxas FROM positions WHERE state = 'closed' AND realized_pnl IS NOT NULL AND $__timeFilter(closed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "type": "table",
      "title": "Por perfil e ativo",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 16,
        "h": 9,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT profile AS perfil, symbol AS ativo, count(*) AS trades, sum(realized_pnl)::float AS pnl, (avg((realized_pnl > 0)::int) * 100)::float AS acerto FROM positions WHERE state = 'closed' AND realized_pnl IS NOT NULL AND $__timeFilter(closed_at) GROUP BY 1, 2 ORDER BY 4 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "table",
      "title": "Motivos de saída",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trade-agent-pg"
      },
      "gridPos": {
        "w": 8,
        "h": 9,
        "x": 16,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trade-agent-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT exit_reason AS motivo, count(*) AS trades, sum(realized_pnl)::float AS pnl FROM positions WHERE state = 'closed' AND realized_pnl IS NOT NULL AND $__timeFilter(closed_at) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 7
    }
  ]
}
