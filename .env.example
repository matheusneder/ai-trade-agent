# Copie para `.env` e preencha. NUNCA versione o `.env` nem as chaves privadas.

# Ambiente da Binance: testnet | demo | prod
#  - testnet: https://testnet.binance.vision        (integração; liquidez irreal)
#  - demo:    https://demo-api.binance.com          (paper trading realista)
#  - prod:    https://api.binance.com               (dinheiro real)
TA_BINANCE_ENV=testnet

# Chave de API do ambiente acima.
# Recomendado: Ed25519, somente "Reading" + "Spot Trading", SEM saques, IP restrito.
TA_BINANCE_API_KEY=

# Tipo da chave: ed25519 (recomendado) | hmac
TA_BINANCE_KEY_TYPE=ed25519

# Ed25519: caminho do arquivo PEM da chave privada (fica fora do git, ex.: ./secrets/)
TA_BINANCE_PRIVATE_KEY_PATH=./secrets/binance-testnet-ed25519.pem
# Senha do PEM, se houver
TA_BINANCE_PRIVATE_KEY_PASSPHRASE=

# HMAC: segredo da chave (somente se TA_BINANCE_KEY_TYPE=hmac)
TA_BINANCE_API_SECRET=

# Trava de segurança: sem `true`, nenhuma ordem é enviada (consultas continuam funcionando).
TA_TRADING_ENABLED=false

# Analista de mercado (Fase 4): chave da API Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Banco de dados (PostgreSQL). Em docker-compose, o host é "postgres".
TA_DATABASE_URL=postgresql+asyncpg://trade_agent:trade_agent_dev@localhost:5432/trade_agent

# recvWindow (ms) das requisições assinadas
TA_BINANCE_RECV_WINDOW_MS=5000

# Logs: DEBUG | INFO | WARNING | ERROR ; formato: console | json
TA_LOG_LEVEL=INFO
TA_LOG_FORMAT=console
