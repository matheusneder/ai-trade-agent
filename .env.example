# Copy to `.env` and fill it in. NEVER commit the `.env` or the private keys.

# Binance environment: testnet | demo | prod
#  - testnet: https://testnet.binance.vision        (integration; unrealistic liquidity)
#  - demo:    https://demo-api.binance.com          (realistic paper trading)
#  - prod:    https://api.binance.com               (real money)
TA_BINANCE_ENV=testnet

# API key of the environment above.
# Recommended: Ed25519, only "Reading" + "Spot Trading", NO withdrawals, IP-restricted.
TA_BINANCE_API_KEY=

# Key type: ed25519 (recommended) | hmac
TA_BINANCE_KEY_TYPE=ed25519

# Ed25519: path to the private key PEM file (kept out of git, e.g. ./secrets/)
TA_BINANCE_PRIVATE_KEY_PATH=./secrets/binance-testnet-ed25519.pem
# PEM passphrase, if any
TA_BINANCE_PRIVATE_KEY_PASSPHRASE=

# HMAC: the key's secret (only if TA_BINANCE_KEY_TYPE=hmac)
TA_BINANCE_API_SECRET=

# Safety lock: without `true`, no order is sent (queries keep working).
TA_TRADING_ENABLED=false

# Market analyst (Phase 4): Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Alerts and commands (Phase 5): create the bot with @BotFather; the chat_id is your user's
# (send a message to the bot and check https://api.telegram.org/bot<TOKEN>/getUpdates)
TA_TELEGRAM_BOT_TOKEN=
TA_TELEGRAM_CHAT_ID=

# External heartbeat (Phase 6): ping URL of the Healthchecks.io check (alerts if the agent stops)
TA_HEALTHCHECK_URL=

# Grafana (deploy/stack.yml): passwords of the admin and of the database's read-only user
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=

# Database (PostgreSQL). In docker-compose, the host is "postgres".
TA_DATABASE_URL=postgresql+asyncpg://trade_agent:trade_agent_dev@localhost:5432/trade_agent

# recvWindow (ms) of signed requests
TA_BINANCE_RECV_WINDOW_MS=5000

# Logs: DEBUG | INFO | WARNING | ERROR ; formato: console | json
TA_LOG_LEVEL=INFO
TA_LOG_FORMAT=console

# Traces (OpenTelemetry): one or more comma-separated destinations. In compose it is already
# http://jaeger:4318,http://signoz-ingester:4318; running with `uv run trade-agent run`, use
# http://127.0.0.1:14318 (compose's SigNoz). Empty: off.
TA_OTLP_ENDPOINT=
# Agent metrics (OpenTelemetry → SigNoz). Outside compose: http://127.0.0.1:14318.
TA_OTLP_METRICS_ENDPOINT=

# SigNoz dashboards (scripts/signoz_dashboards.py --apply): key of a service account with the
# Editor role (Settings → Service Accounts) and the UI address. The agent does not use them.
TA_SIGNOZ_API_KEY=
TA_SIGNOZ_URL=http://127.0.0.1:8080

# ── DEVELOPMENT ONLY: OFF BY DEFAULT ───────────────────────────────────────────────────────────
# Rancher Desktop on Windows: 1 opens the Jaeger UI at http://127.0.0.1:16686, through the
# jaeger-ui relay of deploy/stack.yml (the reason is explained there). On Linux or Kubernetes,
# leave it commented out: the traces are in Grafana (Explore → Traces).
# DEV_JAEGER_UI=1
# Open the Grafana (port 3000) and SigNoz (port 8080) UIs to the local network, e.g. for a
# phone on the same Wi-Fi: 0.0.0.0 (every interface) or this machine's LAN IP. Unset, they
# stay on 127.0.0.1. The access still asks for the login, but over plain HTTP (runbook, §1).
# On a VPS, leave them unset.
# DEV_GRAFANA_UI_HOST=0.0.0.0
# DEV_SIGNOZ_UI_HOST=0.0.0.0
